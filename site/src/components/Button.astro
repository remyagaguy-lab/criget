---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary';
  class?: string;
  type?: 'button' | 'submit';
}

const { href, variant = 'primary', class: className = '', type = 'button' } = Astro.props;

const baseClass = "btn";
const variantClass = variant === 'primary' ? 'btn-primary' : 'btn-secondary';
const classes = `${baseClass} ${variantClass} ${className}`;
---
{href ? (
  <a href={href} class={classes}>
    <slot />
  </a>
) : (
  <button type={type} class={classes}>
    <slot />
  </button>
)}

<style>
  .btn {
    display: inline-block;
    padding: 8px 16px;
    border-radius: var(--radius-buttons);
    font-family: var(--font-family-heading);
    font-weight: 600;
    text-decoration: none;
    text-align: center;
    cursor: pointer;
    transition: background-color 200ms ease-out, color 200ms ease-out, transform 160ms cubic-bezier(0.23, 1, 0.32, 1);
    border: none;
    box-shadow: var(--shadow-sm);
  }
  .btn:active {
    transform: scale(0.97);
  }
  .btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
  }
  .btn-primary {
    background-color: var(--color-brand-deep-green);
    color: var(--color-paper-white);
  }
  .btn-primary:hover {
    background-color: var(--color-brand-green);
  }
  .btn-secondary {
    background-color: transparent;
    color: var(--color-brand-deep-green);
    border: 2px solid var(--color-brand-deep-green);
    box-shadow: none;
  }
  .btn-secondary:hover {
    background-color: var(--color-brand-deep-green);
    color: var(--color-paper-white);
  }
</style>
