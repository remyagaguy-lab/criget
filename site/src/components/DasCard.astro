---
import Icon from './Icon.astro';
interface Props {
  title: string;
  description: string;
  icon?: string;
  href: string;
}
const { title, description, icon, href } = Astro.props;
---
<a href={href} class="das-card" aria-label={`Découvrir ${title}`}>
  {icon && <div class="das-icon" aria-hidden="true"><Icon name={icon} /></div>}
  <h3 class="das-title">{title}</h3>
  <p class="das-desc">{description}</p>
  <span class="das-link">En savoir plus</span>
</a>

<style>
  .das-card {
    display: block;
    background-color: var(--color-paper-white);
    border-radius: var(--radius-cards);
    padding: var(--spacing-24);
    text-decoration: none;
    color: inherit;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--color-mist-gray);
    transition: transform 300ms cubic-bezier(0.23, 1, 0.32, 1), box-shadow 300ms cubic-bezier(0.23, 1, 0.32, 1), outline 200ms;
    height: 100%;
  }
  .das-card:hover {
    transform: translateY(-8px) scale(1.02);
    box-shadow: var(--shadow-sm-2);
  }
  .das-card:focus-visible {
    outline: 3px solid var(--color-brand-deep-green);
    outline-offset: 4px;
    transform: translateY(-4px);
  }
  .das-icon {
    font-size: 2rem;
    margin-bottom: var(--spacing-16);
    color: var(--color-brand-green);
  }
  .das-title {
    color: var(--color-brand-deep-green);
    margin-bottom: var(--spacing-8);
    font-size: 1.25rem;
  }
  .das-desc {
    color: var(--color-ink-black);
    margin-bottom: var(--spacing-24);
    font-size: 0.95rem;
  }
  .das-link {
    font-weight: 600;
    color: var(--color-brand-blue);
  }
  .das-card:hover .das-link {
    text-decoration: underline;
  }
</style>
