---
import Icon from './Icon.astro';
const currentYear = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <!-- 1. Brand -->
      <div class="footer-brand">
        <a href="/fr" class="footer-logo-link" aria-label="Accueil CRIGET-CS">
          <img src="/images/logo-cropped.png" alt="CRIGET-CS Logo" class="footer-logo" />
        </a>
        <p class="footer-desc">Votre partenaire fiable pour le développement durable, l'ingénierie et la géomatique en Afrique de l'Ouest.</p>
      </div>
      
      <!-- 2. Main Page (Entreprise) -->
      <div class="footer-links-col">
        <h2 class="footer-title">Navigation</h2>
        <ul class="footer-links">
          <li><a href="/fr" class="footer-link">Accueil</a></li>
          <li><a href="/fr/a-propos" class="footer-link">À propos</a></li>
          <li><a href="/fr/expertises" class="footer-link">Nos expertises</a></li>
          <li><a href="/fr/blog" class="footer-link">Blog</a></li>
        </ul>
      </div>

      <!-- 3. Services (Légal & Aide) -->
      <div class="footer-links-col">
        <h2 class="footer-title">Légal & Aide</h2>
        <ul class="footer-links">
          <li><a href="/fr/mentions-legales" class="footer-link">Mentions légales</a></li>
          <li><a href="/fr/politique-confidentialite" class="footer-link">Confidentialité</a></li>
          <li><a href="/fr/contact" class="footer-link">Contactez-nous</a></li>
          <li><a href="/fr/expertises#formation" class="footer-link">Formations</a></li>
        </ul>
      </div>

      <!-- 4. Contact Us -->
      <div class="footer-links-col contact-col">
        <h2 class="footer-title">Contact</h2>
        <ul class="footer-contact-list">
          <li>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            <a href="mailto:criget.cs@gmail.com">criget.cs@gmail.com</a>
          </li>
          <li>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            <span>+228 79 19 85 30</span>
          </li>
          <li>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            <a href="https://maps.google.com/maps?q=6.2486664%2C1.1539512&z=17&hl=en" target="_blank" rel="noopener noreferrer">Agoè-Nyivé, Lomé, Togo</a>
          </li>
        </ul>
      </div>
    </div>
    
    <!-- Bottom Section (Rounded Box) -->
    <div class="footer-bottom-box">
      <div class="copyright-info">
        <p>Copyright &copy; {currentYear} CRIGET-CS. Tous droits réservés. <span class="designed-by">Conçu par <a href="https://remyaga.com/portfolio" target="_blank" rel="noopener noreferrer" class="designer-link">Remyaga Guy</a></span></p>
        <span class="legal-rc">RC N°TG-LOME 2016 B1617 &nbsp;|&nbsp; NIF : 1000911186</span>
      </div>
      
      <div class="footer-socials">
        <a href="#" aria-label="LinkedIn" class="social-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
        </a>
        <a href="#" aria-label="Facebook" class="social-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: #1f2937;
    color: var(--color-mist-gray);
    padding: var(--spacing-48) 0 var(--spacing-24) 0;
    font-family: var(--font-family-body);
  }
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--spacing-24);
  }
  
  .footer-grid {
    display: grid;
    grid-template-columns: 3.5fr 2fr 2fr 3.5fr;
    gap: var(--spacing-32);
    margin-bottom: var(--spacing-48);
  }
  
  /* Brand */
  .footer-brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-16);
    padding-right: var(--spacing-24);
  }
  .footer-logo {
    width: 240px;
    height: auto;
    max-width: 100%;
    object-fit: contain;
    transition: opacity 200ms ease;
    /* Ce filtre transforme n'importe quel logo sombre en logo 100% blanc */
    filter: brightness(0) invert(1);
    opacity: 0.9;
  }
  .footer-logo:hover {
    opacity: 1;
  }
  .footer-desc {
    color: var(--color-mist-gray);
    font-size: 0.95rem;
    line-height: 1.5;
    margin: 0;
  }

  /* Titles */
  .footer-title {
    color: var(--color-paper-white);
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: var(--spacing-24);
    font-family: var(--font-family-heading);
  }

  /* Links */
  .footer-links-col {
    display: flex;
    flex-direction: column;
  }
  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .footer-link {
    color: #9ca3af; /* Light gray */
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 200ms ease;
  }
  .footer-link:hover {
    color: var(--color-paper-white);
  }

  /* Contact Column */
  .footer-contact-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .footer-contact-list li {
    display: flex;
    align-items: center;
    gap: 12px;
    color: #9ca3af;
    font-size: 0.95rem;
  }
  .footer-contact-list li svg {
    flex-shrink: 0;
    color: var(--color-paper-white);
  }
  .footer-contact-list a {
    color: inherit;
    text-decoration: none;
    transition: color 200ms ease;
  }
  .footer-contact-list a:hover {
    color: var(--color-paper-white);
  }

  /* Bottom Box (like the screenshot) */
  .footer-bottom-box {
    background-color: rgba(255, 255, 255, 0.05); /* Slight box effect */
    border-radius: 12px;
    padding: var(--spacing-24) var(--spacing-32);
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: #9ca3af;
  }
  
  .copyright-info {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .copyright-info p {
    margin: 0;
    font-size: 0.9rem;
  }
  .designed-by {
    margin-left: 8px;
  }
  .designer-link {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.4);
    text-underline-offset: 4px;
    transition: color 200ms ease;
  }
  .designer-link:hover {
    color: var(--color-paper-white);
    text-decoration-color: var(--color-paper-white);
  }
  .legal-rc {
    font-size: 0.8rem;
    opacity: 0.7;
  }

  .footer-socials {
    display: flex;
    gap: 16px;
  }
  
  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: transparent;
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--color-paper-white);
    transition: all 200ms ease;
  }
  .social-icon:hover {
    background-color: var(--color-brand-deep-green);
    border-color: var(--color-brand-deep-green);
    transform: translateY(-2px);
  }

  /* Responsive */
  @media (max-width: 992px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--spacing-48);
    }
    .footer-brand {
      grid-column: 1 / -1;
      padding-right: 0;
      max-width: 500px;
    }
  }
  
  @media (max-width: 576px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: var(--spacing-32);
      margin-bottom: var(--spacing-32);
    }
    .footer-bottom-box {
      flex-direction: column;
      text-align: center;
      gap: var(--spacing-24);
      padding: var(--spacing-24) var(--spacing-16);
    }
    .copyright-info {
      flex-direction: column;
      gap: 8px;
    }
  }
</style>
