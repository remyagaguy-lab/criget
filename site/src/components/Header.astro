---
import Button from './Button.astro';
---
<header class="site-header">
  <div class="container header-inner">
    <a href="/fr" class="logo-link" aria-label="Accueil CRIGET-CS">
      <img src="/images/logo-transparent.png" alt="CRIGET-CS Logo" class="logo-img" />
    </a>

    <!-- Mobile Menu Toggle -->
    <button class="mobile-toggle" aria-expanded="false" aria-controls="main-nav" aria-label="Ouvrir le menu">
      <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"></path></svg>
    </button>

    <nav id="main-nav" class="main-nav">
      <ul class="nav-list">
        <li><a href="/fr" class="nav-link">Accueil</a></li>
        <li><a href="/fr/expertises" class="nav-link">Nos expertises</a></li>
        <li><a href="/fr/a-propos" class="nav-link">À propos</a></li>
        <li><a href="/fr/blog" class="nav-link">Blog</a></li>
        <li><a href="/fr/contact" class="nav-link">Contact</a></li>
      </ul>
      <div class="header-cta">
        <Button href="/fr/contact" variant="primary">Nous contacter</Button>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background-color: var(--color-paper-white);
    border-bottom: 1px solid var(--color-mist-gray);
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--spacing-24);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }
  .logo-img {
    height: 60px;
    width: auto;
    transform: scale(1.8);
    transform-origin: left center;
  }
  .main-nav {
    display: flex;
    align-items: center;
    flex: 1;
    justify-content: flex-end;
  }
  .nav-list {
    display: flex;
    list-style: none;
    gap: var(--spacing-24);
    margin: 0 auto;
    padding: 0;
    align-items: center;
  }
  .nav-link {
    color: var(--color-ink-black);
    text-decoration: none;
    font-weight: 500;
    font-family: var(--font-family-heading);
    padding: var(--spacing-8);
    transition: color 200ms ease-out;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1rem;
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .nav-link:hover, .nav-link:focus {
    color: var(--color-brand-deep-green);
  }
  .has-dropdown {
    position: relative;
  }
  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    background: var(--color-paper-white);
    border: 1px solid var(--color-mist-gray);
    border-radius: var(--radius-cards);
    box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1);
    list-style: none;
    padding: var(--spacing-8) 0;
    margin: 0;
    min-width: 250px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px) scale(0.95);
    transform-origin: top center;
    transition: transform 200ms cubic-bezier(0.23, 1, 0.32, 1), opacity 200ms cubic-bezier(0.23, 1, 0.32, 1), visibility 200ms;
  }
  .has-dropdown:hover .dropdown-menu,
  .dropdown-toggle[aria-expanded="true"] + .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }
  .dropdown-link {
    display: block;
    padding: var(--spacing-8) var(--spacing-24);
    color: var(--color-ink-black);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .dropdown-link:hover, .dropdown-link:focus {
    background-color: var(--color-mist-gray);
    color: var(--color-brand-deep-green);
  }
  .mobile-toggle {
    display: none;
    background: none;
    border: none;
    color: var(--color-ink-black);
    cursor: pointer;
    padding: var(--spacing-8);
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .mobile-toggle {
      display: block;
    }
    .main-nav {
      display: none;
      position: absolute;
      top: 64px;
      left: 0;
      right: 0;
      background: var(--color-paper-white);
      flex-direction: column;
      padding: var(--spacing-24);
      border-bottom: 1px solid var(--color-mist-gray);
      box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
    }
    .main-nav.is-open {
      display: flex;
    }
    .nav-list {
      flex-direction: column;
      width: 100%;
      align-items: flex-start;
      gap: 0;
    }
    .has-dropdown {
      width: 100%;
    }
    .dropdown-menu {
      position: static;
      opacity: 1;
      visibility: visible;
      transform: none;
      box-shadow: none;
      border: none;
      border-left: 2px solid var(--color-mist-gray);
      margin-left: var(--spacing-8);
      border-radius: 0;
      display: none;
    }
    .dropdown-toggle[aria-expanded="true"] + .dropdown-menu {
      display: block;
    }
    .header-cta {
      margin-top: var(--spacing-24);
      width: 100%;
    }
    .header-cta :global(.btn) {
      width: 100%;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const mobileToggle = document.querySelector('.mobile-toggle');
    const mainNav = document.getElementById('main-nav');
    
    if (mobileToggle && mainNav) {
      mobileToggle.addEventListener('click', () => {
        const isExpanded = mobileToggle.getAttribute('aria-expanded') === 'true';
        mobileToggle.setAttribute('aria-expanded', String(!isExpanded));
        mainNav.classList.toggle('is-open');
      });
    }

    const dropdownToggles = document.querySelectorAll('.dropdown-toggle');
    dropdownToggles.forEach(toggle => {
      toggle.addEventListener('click', (e) => {
        e.preventDefault();
        const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!isExpanded));
      });
    });
  });
</script>
