---
import { getEntry } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/404');

const entry = await getEntry('blog', slug);
if (!entry) return Astro.redirect('/404');

const { Content } = await entry.render();

// Formatage de la date en français
const formatter = new Intl.DateTimeFormat('fr-FR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
const formattedDate = formatter.format(entry.data.pubDate);
---

<Layout title={entry.data.title} description={entry.data.description || `Article du blog CRIGET : ${entry.data.title}`} image={entry.data.image}>
  <main>
    <article class="blog-post">
      <header class="post-header">
        <div class="container post-container">
          <div class="breadcrumb">
            <a href="/fr">Accueil</a> › <a href="/fr/blog">Blog</a> › <span>{entry.data.title}</span>
          </div>
          
          <h1 class="post-title">{entry.data.title}</h1>
          <div class="post-meta">
            <span class="post-date">Publié le {formattedDate}</span>
          </div>
          
          {entry.data.image && (
            <div class="post-image">
              <img src={entry.data.image} alt={entry.data.title} />
            </div>
          )}
        </div>
      </header>

      <div class="post-content">
        <div class="container post-container">
          <div class="prose">
            <Content />
          </div>
          
          <div class="post-footer">
            {entry.data.author && (
              <div class="author-card">
                <div class="author-avatar">
                  {entry.data.authorAvatar ? (
                    <img src={entry.data.authorAvatar} alt={entry.data.author} />
                  ) : (
                    <div class="avatar-placeholder">{entry.data.author.charAt(0)}</div>
                  )}
                </div>
                <div class="author-info">
                  <div class="author-name">{entry.data.author}</div>
                  {entry.data.authorRole && <div class="author-role">{entry.data.authorRole}</div>}
                </div>
              </div>
            )}
            <a href="/fr/blog" class="button-cta">← Retour aux articles</a>
          </div>
        </div>
      </div>
    </article>
  </main>
</Layout>

<style>
  .container { max-width: 1200px; margin: 0 auto; padding: 0 var(--spacing-24); }
  .post-container { max-width: 800px; /* Largeur optimale pour la lecture */ }
  
  .post-header {
    background-color: var(--color-paper-white);
    padding: var(--spacing-64) 0 var(--spacing-32);
  }
  
  .breadcrumb { font-size: 0.875rem; margin-bottom: var(--spacing-32); }
  .breadcrumb a { color: var(--color-brand-deep-green); text-decoration: none; font-weight: 500; }
  .breadcrumb span { color: var(--color-neutral-gray); }
  
  .post-title {
    font-size: 2rem;
    line-height: 1.3;
    color: var(--color-ink-black);
    margin-bottom: var(--spacing-24);
  }
  
  .post-meta {
    margin-bottom: var(--spacing-48);
    font-size: 0.95rem;
    color: var(--color-brand-deep-green);
    font-weight: 500;
  }
  
  .post-image {
    margin-top: var(--spacing-32);
    border-radius: var(--radius-largecontainers);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }
  
  .post-image img {
    width: 100%;
    height: auto;
    max-height: 500px;
    object-fit: cover;
    display: block;
  }
  
  .post-content {
    background-color: var(--color-paper-white);
    padding: var(--spacing-48) 0 var(--spacing-96);
  }
  
  /* Styles pour le Markdown (Prose) */
  .prose {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--color-ink-black);
  }
  
  .prose :global(h2) {
    font-size: 2rem;
    color: var(--color-brand-deep-green);
    margin-top: var(--spacing-48);
    margin-bottom: var(--spacing-24);
  }
  
  .prose :global(h3) {
    font-size: 1.5rem;
    color: var(--color-ink-black);
    margin-top: var(--spacing-32);
    margin-bottom: var(--spacing-16);
  }
  
  .prose :global(p) {
    margin-bottom: var(--spacing-24);
    text-align: justify;
    -webkit-hyphens: auto;
    hyphens: auto;
  }
  
  .prose :global(ul), .prose :global(ol) {
    margin-bottom: var(--spacing-24);
    padding-left: var(--spacing-32);
  }
  
  .prose :global(li) {
    margin-bottom: var(--spacing-8);
  }
  
  .prose :global(strong) {
    font-weight: 600;
    color: var(--color-true-black);
  }
  
  .prose :global(a) {
    color: var(--color-brand-blue);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  
  .prose :global(blockquote) {
    border-left: 4px solid var(--color-brand-deep-green);
    padding-left: var(--spacing-24);
    margin-left: 0;
    font-style: italic;
    color: #555;
  }
  
  .post-footer {
    margin-top: var(--spacing-64);
    padding-top: var(--spacing-32);
    border-top: 1px solid var(--color-mist-gray);
  }
  
  .author-card {
    display: flex;
    align-items: center;
    gap: var(--spacing-16);
    margin-bottom: var(--spacing-32);
    padding: var(--spacing-24);
    background-color: #f9fafb;
    border-radius: var(--radius-largecontainers);
    border: 1px solid var(--color-mist-gray);
  }
  .author-avatar {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    background-color: var(--color-brand-deep-green);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 1.5rem;
    font-weight: 700;
  }
  .author-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .author-name {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-ink-black);
    margin-bottom: 4px;
  }
  .author-role {
    font-size: 0.9rem;
    color: var(--color-neutral-gray);
  }

  /* Accordéon FAQ */
  .prose :global(details) {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    margin-bottom: 12px;
    padding: 16px;
    box-shadow: 0 1px 2px rgba(0,0,0,0.05);
    transition: all 0.2s ease;
  }
  .prose :global(details[open]) {
    border-color: var(--color-brand-deep-green);
    box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
  }
  .prose :global(summary) {
    font-weight: 600;
    cursor: pointer;
    color: var(--color-ink-black);
    list-style: none;
    position: relative;
    padding-right: 24px;
  }
  .prose :global(summary::-webkit-details-marker) {
    display: none;
  }
  .prose :global(summary::after) {
    content: '+';
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-brand-deep-green);
    font-size: 1.2rem;
    transition: transform 0.2s ease;
  }
  .prose :global(details[open] summary::after) {
    content: '−';
  }
  .prose :global(details p) {
    margin-top: 16px;
    margin-bottom: 0;
    color: #4b5563;
  }
  
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: var(--spacing-32) 0;
    font-size: 0.95rem;
    display: block;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  
  .prose :global(th), .prose :global(td) {
    border: 1px solid #d1d5db; /* Bordure grise claire */
    padding: 12px 16px;
    text-align: left;
    vertical-align: top;
  }
  
  .prose :global(th) {
    background-color: #f3f4f6; /* Fond légèrement gris pour l'entête */
    color: var(--color-brand-deep-green);
    font-weight: 600;
  }
  
  .prose :global(tr:nth-child(even)) {
    background-color: #f9fafb; /* Lignes zébrées */
  }
  
  @media (max-width: 768px) {
    .post-title { font-size: 1.5rem; }
    .post-header { padding: var(--spacing-32) 0; }
    
    .prose :global(h2) {
      font-size: 1.5rem;
      margin-top: var(--spacing-32);
      margin-bottom: var(--spacing-16);
    }
  }
</style>
