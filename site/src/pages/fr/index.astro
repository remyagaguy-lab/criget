---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';

// Récupérer les 3 derniers articles
const blogEntries = await getCollection('blog');
const recentEntries = blogEntries
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const formatter = new Intl.DateTimeFormat('fr-FR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<Layout title="Accueil">
  <div class="content-wrapper">
    <!-- HERO SECTION -->
    <section class="hero-section">
      <div class="container hero-inner">
        <h1 class="hero-title fade-in-up">Votre partenaire fiable pour le développement durable.</h1>
        <p class="hero-mission fade-in-up delay-100">Développer des solutions idoines et adaptées pour le Togo et les pays d'Afrique dans les domaines de la gouvernance de l'environnement, l'aménagement du territoire, et l'innovation en milieu rural.</p>
        <div class="hero-cta fade-in-up delay-200">
          <Button href="/fr/expertises/ingenierie" variant="primary">Découvrir nos expertises</Button>
          <Button href="/fr/contact" variant="secondary">Nous contacter</Button>
        </div>
      </div>
    </section>

    <!-- DAS DETAILS SECTIONS (ZIG-ZAG) -->
    <div class="das-zigzag-wrapper">
      <div class="container">
        <h2 class="section-title">Nos domaines d'activités stratégiques</h2>
      </div>

      <!-- DAS 1 -->
      <section class="das-zigzag-section">
        <div class="container">
          <div class="das-grid">
            <div class="das-content">
              <h3>Ingénierie pour le développement</h3>
              <p>Nous concevons des infrastructures résilientes et adaptons les aménagements ruraux et urbains aux défis climatiques actuels. Nos études de faisabilité garantissent la viabilité de vos projets.</p>
              <ul>
                <li>Aménagement hydro-agricole</li>
                <li>Infrastructures de transport rural</li>
                <li>Gestion des ressources en eau</li>
              </ul>
              <Button href="/fr/expertises#ingenierie" variant="secondary">En savoir plus</Button>
            </div>
            <div class="das-image-wrapper">
              <img src="/images/das-ingenierie.png" alt="Ingénierie pour le développement" class="das-image" />
            </div>
          </div>
        </div>
      </section>

      <!-- DAS 2 -->
      <section class="das-zigzag-section bg-alt">
        <div class="container">
          <div class="das-grid reverse">
            <div class="das-content">
              <h3>Études environnementales et sociales</h3>
              <p>Nous accompagnons les décideurs avec des évaluations d'impact rigoureuses et des plans de gestion environnementale conformes aux standards internationaux (Banque Mondiale, SFI).</p>
              <ul>
                <li>Études d'impact environnemental (EIES)</li>
                <li>Audits de conformité</li>
                <li>Plans de réinstallation des populations</li>
              </ul>
              <Button href="/fr/expertises#recherche" variant="secondary">En savoir plus</Button>
            </div>
            <div class="das-image-wrapper">
              <img src="/images/das-recherche.png" alt="Études environnementales et sociales" class="das-image" />
            </div>
          </div>
        </div>
      </section>

      <!-- DAS 3 -->
      <section class="das-zigzag-section">
        <div class="container">
          <div class="das-grid">
            <div class="das-content">
              <h3>Géomatique et Aménagement du Territoire</h3>
              <p>Exploitez la puissance des données spatiales pour optimiser la gestion foncière et planifier le développement local grâce à nos Systèmes d'Information Géographique (SIG).</p>
              <ul>
                <li>Cartographie thématique et webmapping</li>
                <li>Planification urbaine et rurale</li>
                <li>Télédétection par drone et satellite</li>
              </ul>
              <Button href="/fr/expertises#geomatique" variant="secondary">En savoir plus</Button>
            </div>
            <div class="das-image-wrapper">
              <img src="/images/das-geomatique.png" alt="Géomatique et Aménagement du Territoire" class="das-image" />
            </div>
          </div>
        </div>
      </section>

      <!-- DAS 4 -->
      <section class="das-zigzag-section bg-alt">
        <div class="container">
          <div class="das-grid reverse">
            <div class="das-content">
              <h3>Renforcement de capacités</h3>
              <p>Nous formons les cadres, techniciens et communautés locales pour garantir l'appropriation des outils technologiques et assurer la pérennité des projets de développement.</p>
              <ul>
                <li>Formations sur mesure en SIG</li>
                <li>Ateliers de sensibilisation climat</li>
                <li>Accompagnement technique continu</li>
              </ul>
              <Button href="/fr/expertises#formation" variant="secondary">En savoir plus</Button>
            </div>
            <div class="das-image-wrapper">
              <img src="/images/das-formation.png" alt="Renforcement de capacités" class="das-image" />
            </div>
          </div>
        </div>
      </section>
    </div>

    <!-- BLOG SECTION -->
    <section class="blog-section">
      <div class="container">
        <div class="blog-header">
          <h2 class="section-title">Nos dernières publications</h2>
          <a href="/fr/blog" class="button-cta outline">Voir tout le blog</a>
        </div>
        <div class="blog-grid">
          {recentEntries.map(entry => (
            <article class="blog-card">
              {entry.data.image && (
                <div class="blog-card-image">
                  <img src={entry.data.image} alt={entry.data.title} />
                </div>
              )}
              <div class="blog-card-content">
                <span class="blog-date">{formatter.format(entry.data.pubDate)}</span>
                <h3>{entry.data.title}</h3>
                <p>{entry.data.description}</p>
                <a href={`/fr/blog/${entry.slug}`} class="blog-link">Lire la suite →</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- SECTION CTA -->
    <section class="section-cta">
      <div class="container section-cta-inner">
        <h2>Prêt à concrétiser votre projet ?</h2>
        <p>Contactez nos experts pour une analyse personnalisée de vos besoins.</p>
        <Button href="/fr/contact" variant="primary">Demander une consultation</Button>
      </div>
    </section>
  </div>
</Layout>

<style>
  .container {
    max-width: var(--page-max-width);
    margin: 0 auto;
    padding: 0 var(--spacing-24);
  }

  /* HERO */
  .hero-section {
    padding: var(--spacing-48) 0 var(--spacing-80);
    background: linear-gradient(to bottom, var(--color-paper-white), var(--color-mist-gray));
    border-bottom: 1px solid var(--color-cloud-gray);
  }
  .hero-inner {
    max-width: 800px;
    text-align: center;
  }
  .hero-title {
    font-size: var(--text-display);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    color: var(--color-brand-deep-green);
    margin-bottom: var(--spacing-24);
  }
  .hero-mission {
    font-size: var(--text-subheading);
    color: var(--color-ink-black);
    margin-bottom: var(--spacing-48);
  }
  .hero-cta {
    display: flex;
    gap: var(--spacing-16);
    justify-content: center;
  }

  /* ZIGZAG SECTIONS */
  .das-zigzag-wrapper {
    padding: var(--spacing-48) 0 var(--spacing-96) 0;
  }
  .section-title {
    text-align: center;
    font-size: 2.25rem;
    margin-bottom: var(--spacing-48);
    color: var(--color-brand-deep-green);
  }
  .das-zigzag-section {
    padding: var(--spacing-64) 0;
  }
  .bg-alt {
    background-color: var(--color-mist-gray);
  }
  .das-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-64);
    align-items: center;
  }
  .das-grid.reverse .das-content {
    order: 2;
  }
  .das-grid.reverse .das-image-wrapper {
    order: 1;
  }
  .das-content h3 {
    font-size: 2rem;
    color: var(--color-brand-deep-green);
    margin-bottom: var(--spacing-24);
  }
  .das-content p {
    font-size: 1.125rem;
    color: var(--color-ink-black);
    margin-bottom: var(--spacing-24);
    line-height: 1.6;
  }
  .das-content ul {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--spacing-32) 0;
  }
  .das-content ul li {
    position: relative;
    padding-left: var(--spacing-24);
    margin-bottom: var(--spacing-12);
    font-size: 1.05rem;
    color: var(--color-ink-black);
  }
  .das-content ul li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: var(--color-brand-deep-green);
    font-weight: bold;
  }
  .das-image-wrapper {
    border-radius: var(--radius-largecontainers);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }
  .das-image {
    width: 100%;
    height: 400px;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }
  .das-image-wrapper:hover .das-image {
    transform: scale(1.02);
  }

  /* BLOG SECTION */
  .blog-section {
    padding: var(--spacing-96) 0;
    background-color: var(--color-paper-white);
  }
  .blog-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--spacing-48);
  }
  .blog-header .section-title {
    margin-bottom: 0;
  }
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--spacing-32);
  }
  .blog-card {
    background: var(--color-paper-white);
    border: 1px solid var(--color-mist-gray);
    border-radius: var(--radius-cards);
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    display: flex;
    flex-direction: column;
  }
  .blog-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-sm);
  }
  .blog-card-image img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    display: block;
  }
  .blog-card-content {
    padding: var(--spacing-24);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  .blog-date {
    display: block;
    font-size: 0.875rem;
    color: var(--color-brand-deep-green);
    margin-bottom: var(--spacing-8);
    font-weight: 500;
  }
  .blog-card-content h3 {
    font-size: 1.25rem;
    margin-bottom: var(--spacing-16);
    line-height: 1.4;
  }
  .blog-card-content p {
    font-size: 0.95rem;
    color: var(--color-ink-black);
    margin-bottom: var(--spacing-24);
    line-height: 1.5;
    flex-grow: 1;
  }
  .blog-link {
    display: inline-block;
    color: var(--color-brand-deep-green);
    font-weight: 600;
    text-decoration: none;
    font-size: 0.95rem;
    margin-top: auto;
  }
  .blog-link:hover {
    text-decoration: underline;
  }
  
  /* CTA */
  .section-cta {
    padding: var(--spacing-96) 0;
    background-color: var(--color-brand-deep-green);
    color: var(--color-paper-white);
    text-align: center;
  }
  .section-cta-inner h2 {
    color: var(--color-paper-white);
    font-size: 2.5rem;
    margin-bottom: var(--spacing-16);
  }
  .section-cta-inner p {
    font-size: 1.25rem;
    margin-bottom: var(--spacing-32);
    opacity: 0.9;
  }

  /* MEDIA QUERIES */


  /* MEDIA QUERIES */
  @media (max-width: 900px) {
    .das-grid {
      grid-template-columns: 1fr;
      gap: var(--spacing-32);
    }
    .das-grid.reverse .das-content {
      order: 1;
    }
    .das-grid.reverse .das-image-wrapper {
      order: 2;
    }
    .hero-title { font-size: 2.5rem; }
    .hero-section { padding: var(--spacing-32) 0; }
    .hero-cta { flex-direction: column; }
    .blog-header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--spacing-16);
    }
  }
</style>
