---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

// Récupérer et trier les articles par date (du plus récent au plus ancien)
const blogEntries = await getCollection('blog');
const sortedEntries = blogEntries.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Formateur de date
const formatter = new Intl.DateTimeFormat('fr-FR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<Layout title="Notre Blog">
  <main>
    <section class="page-hero">
      <div class="container">
        <div class="breadcrumb"><a href="/fr">Accueil</a> › <span>Blog</span></div>
        <h1>Notre Blog</h1>
        <p class="lead">Actualités, analyses et réflexions de nos experts sur le développement durable, la géomatique et l'environnement en Afrique.</p>
      </div>
    </section>

    <section class="blog-section">
      <div class="container">
        <div class="blog-grid">
          {sortedEntries.map(entry => (
            <article class="blog-card">
              {entry.data.image && (
                <div class="blog-card-image">
                  <img src={entry.data.image} alt={entry.data.title} />
                </div>
              )}
              <div class="blog-card-content">
                <span class="blog-date">{formatter.format(entry.data.pubDate)}</span>
                <h3>{entry.data.title}</h3>
                <p>{entry.data.description}</p>
                <a href={`/fr/blog/${entry.slug}`} class="blog-link">Lire la suite →</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .container { max-width: 1200px; margin: 0 auto; padding: 0 var(--spacing-24); }
  
  .page-hero { 
    background-color: var(--color-mist-gray); 
    color: var(--color-ink-black); 
    padding: var(--spacing-96) 0 var(--spacing-64); 
  }
  .breadcrumb { font-size: 0.875rem; margin-bottom: var(--spacing-24); }
  .breadcrumb a { color: var(--color-brand-deep-green); text-decoration: none; font-weight: 500; }
  .breadcrumb span { color: var(--color-neutral-gray); }
  .page-hero h1 { color: var(--color-brand-deep-green); font-size: 2.75rem; margin-bottom: var(--spacing-24); }
  .lead { font-size: 1.15rem; color: var(--color-ink-black); max-width: 600px; }

  .blog-section {
    padding: var(--spacing-96) 0;
    background-color: var(--color-paper-white);
  }
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--spacing-32);
  }
  .blog-card {
    background: var(--color-paper-white);
    border: 1px solid var(--color-mist-gray);
    border-radius: var(--radius-cards);
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    display: flex;
    flex-direction: column;
  }
  .blog-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-sm);
  }
  .blog-card-image img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    display: block;
  }
  .blog-card-content {
    padding: var(--spacing-24);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  .blog-date {
    display: block;
    font-size: 0.875rem;
    color: var(--color-brand-deep-green);
    margin-bottom: var(--spacing-8);
    font-weight: 500;
  }
  .blog-card-content h3 {
    font-size: 1.25rem;
    margin-bottom: var(--spacing-16);
    line-height: 1.4;
  }
  .blog-card-content p {
    font-size: 0.95rem;
    color: var(--color-ink-black);
    margin-bottom: var(--spacing-24);
    line-height: 1.5;
    flex-grow: 1;
  }
  .blog-link {
    display: inline-block;
    color: var(--color-brand-deep-green);
    font-weight: 600;
    text-decoration: none;
    font-size: 0.95rem;
    margin-top: auto;
  }
  .blog-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 900px) {
    .page-hero h1 { font-size: 1.875rem; }
    .page-hero { padding: var(--spacing-64) 0; }
    .blog-section { padding: var(--spacing-64) 0; }
  }
</style>
