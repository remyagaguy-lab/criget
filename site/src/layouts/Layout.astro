---
import '../styles/tokens.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { 
  title, 
  description = "CRIGET - Centre de Recherche en Ingénierie, Gestion et Études Technologiques",
  image = "/images/logo-cropped.png" 
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.url.origin);
const fullImageUrl = new URL(image, Astro.url.origin);
---
<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} | CRIGET-CS</title>
    <link rel="icon" type="image/x-icon" sizes="32x32 64x64 128x128" href="/favicon.ico?v=6" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon.ico?v=6" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | CRIGET-CS`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageUrl} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={`${title} | CRIGET-CS`} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={fullImageUrl} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Passer au contenu principal</a>
    <Header />
    <div id="main-content" tabindex="-1">
      <slot />
    </div>
    <Footer />
  </body>
</html>
